# OpenOutreach — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# APP_ENV options: development | production | staging

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection (app auto-falls back to SQLite if unavailable in dev)
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/openoutreach
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openoutreach
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── AI / OpenRouter API Keys ──────────────────────────────────────────────────
# Get your keys at: https://openrouter.ai
AI_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: rotate across multiple keys for resilience
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here

# ── AI Models ─────────────────────────────────────────────────────────────────
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_1=google/gemini-2.5-flash:free
OPENROUTER_MODEL_2=qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_MODEL_3=meta-llama/llama-3.1-8b-instruct:free

# ── Lead Discovery ────────────────────────────────────────────────────────────
# Provider options: excel | apollo | web_search | hybrid | mock
LEAD_DISCOVERY_PROVIDER=excel
LEAD_PROVIDER=excel
EXCEL_FILE_PATH=data/input_csv/Master_Contact_List.xlsx

# Optional: Apollo.io API (for apollo/hybrid provider)
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io/v1
APOLLO_ENABLED=false

# Optional: Web search providers (for web_search/hybrid provider)
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_KEY=your_serpapi_key_here
WEB_SEARCH_API_KEY=your_web_search_api_key_here

# ── Google OAuth 2.0 (for Gmail mailbox integration) ─────────────────────────
# Setup at: https://console.cloud.google.com → APIs & Services → Credentials
# App type: Web application
# Note: GOOGLE_CLIENT_ID should be the OAuth 2.0 client ID (ends in .apps.googleusercontent.com)
# NOT the Gmail address itself
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# URL where the React frontend is served (used by backend for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (production: your real domain)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Test Recipients (for campaign testing/demo only) ──────────────────────────
TEST_RECIPIENT_1_EMAIL=your_test_email_1@gmail.com
TEST_RECIPIENT_1_NAME=Test Recipient 1
TEST_RECIPIENT_2_EMAIL=your_test_email_2@gmail.com
TEST_RECIPIENT_2_NAME=Test Recipient 2
TEST_RECIPIENT_3_EMAIL=your_test_email_3@gmail.com
TEST_RECIPIENT_3_NAME=Test Recipient 3
