# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Secrets & Environment ────────────────────────────────────────────────────
# NEVER commit actual .env files — use .env.example as the template
.env
.env.local
.env.production
.env.staging
frontend/.env
frontend/.env.local

# ─── Database Files ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/openoutreach.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
backend/logs/
logs/
*.log

# ─── Data / Uploads ───────────────────────────────────────────────────────────
/data/*
!/data/.gitkeep
!/data/input_csv/.gitkeep
/media/

# Excel contact lists should NOT be committed (contain PII)
*.xlsx
*.xls
*.csv

# ─── Frontend / Node ──────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.cache/

# ─── Tests ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
tests/fixtures/pages/**/*.html

# ─── IDE / Editors ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Docker ──────────────────────────────────────────────────────────────────
.dockerignore
